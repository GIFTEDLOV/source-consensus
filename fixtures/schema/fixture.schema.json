{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GIFTEDLOV/source-consensus/fixtures/schema/fixture.schema.json",
  "title": "SourceConsensus fixture case",
  "description": "One bounded factual query, the honest per-source extraction a correct model would produce from the committed corpus, and the status the contract must derive from it. The expected status is NOT taken on trust: tools/validate_fixtures.py recomputes it with tools/canonical.py and fails on disagreement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "description", "config", "source_results", "expected"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "unanimous",
        "majority",
        "conflict",
        "insufficient",
        "unavailable-source",
        "adversarial",
        "normalisation",
        "ambiguous",
        "unavailable-aggregate"
      ]
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 400 },
    "notes": { "type": "string", "maxLength": 1200 },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "question",
        "fact_type",
        "normalization_rules",
        "allowed_enum_values",
        "source_urls",
        "minimum_supporting_sources",
        "conflict_threshold",
        "require_pinned_evidence"
      ],
      "properties": {
        "query_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "question": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fact_type": {
          "type": "string",
          "enum": ["STRING", "INTEGER", "BOOLEAN", "DATE", "ENUM"]
        },
        "normalization_rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_policy": { "type": "string", "enum": ["PRESERVE", "LOWER"] },
            "min_value": { "type": "integer" },
            "max_value": { "type": "integer" }
          }
        },
        "allowed_enum_values": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "source_urls": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "format": "uri", "maxLength": 400 }
        },
        "minimum_supporting_sources": { "type": "integer", "minimum": 2, "maximum": 5 },
        "conflict_threshold": { "type": "integer", "minimum": 1, "maximum": 5 },
        "require_pinned_evidence": { "type": "boolean" }
      }
    },
    "source_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_index", "state", "value"],
        "properties": {
          "source_index": { "type": "integer", "minimum": 0, "maximum": 4 },
          "state": {
            "type": "string",
            "enum": ["VALUE", "NO_VALUE", "UNAVAILABLE", "AMBIGUOUS"]
          },
          "value": { "type": ["string", "null"], "maxLength": 200 }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "normalized_value"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["CONFIRMED", "CONFLICTED", "INSUFFICIENT_EVIDENCE", "UNAVAILABLE"]
        },
        "normalized_value": { "type": ["string", "null"], "maxLength": 200 }
      }
    }
  }
}
